# third-party slicing engine - download it (see README, section 2.2)
engine/PrusaSlicer-*/
engine/download/

# build output (recreated by: python tools/build_exe.py)
build/
__pycache__/
*.pyc

# personal settings and runtime files (recreated automatically)
tools/d4_settings.json
tools/d4_settings.json.tmp

# everything the app makes: print files (.x3g / .gcode), previews, logs, fit-check reports,
# GUI review screenshots (output/gui_review) - recreated on this PC, never shared
output/

# my own 3D models / designs (STL files) - kept on this PC only.
# the two test models stay: the self-test slices test_nut.stl, the README uses both.
models/*
!models/test_nut.stl
!models/test_step_tower.stl

# my own design scripts (each makes one object; the app never uses them) - run them as
#   python designs/make_xxx.py      (they save into models/ and borrow helpers from tools/)
designs/

# copy of the licence texts the .exe makes for its About box (originals: LICENSE, licenses/)
licences/
